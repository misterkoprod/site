*,*::before,*::after{box-sizing:border-box}body,h1,h2,h3,p{margin:0}img,video{max-width:100%;display:block}:root{--color-bg:#020b1f;--color-surface:transparent;--color-text:#f4f6fb;--color-muted:#aeb8cc;--color-border:rgba(255, 255, 255, 0.18);--font-body:Verdana, Geneva, sans-serif;--font-title:Impact, Haettenschweiler, "Arial Narrow Bold", sans-serif;--space-sm:0.75rem;--space-md:1.5rem;--space-lg:3rem;--site-width:960px}html{min-height:100%;background:radial-gradient(circle at 8% 8%,rgba(110,170,255,.38) 0%,rgba(70,120,220,.28) 16%,rgba(30,70,150,.18) 32%,rgba(10,30,70,.1) 48%,transparent 68%),radial-gradient(circle at 22% 18%,rgba(140,200,255,.14) 0%,rgba(80,140,255,6%) 24%,transparent 52%),radial-gradient(circle at 50% 20%,rgba(20,60,120,.1) 0%,transparent 55%),radial-gradient(circle at bottom right,rgba(0,0,0,.42) 0%,rgba(0,0,0,.82) 60%),linear-gradient(135deg,#08192f 0%,#031124 30%,#020915 65%,#000000 100%);background-attachment:fixed}body{min-height:100vh;margin:0;line-height:1.6;font-family:var(--font-body);color:var(--color-text);background:0 0;box-shadow:inset 0 0 220px rgba(0,0,0,.34),inset 0 0 420px rgba(0,0,0,.24),inset 0 0 620px rgba(0,0,0,.12)}main{width:calc(100% - 4rem);max-width:var(--site-width);margin:0 auto;padding:5rem 0}h1,h2,h3,h4,h5,h6{font-family:var(--font-title);color:#fff;letter-spacing:.04em;margin-bottom:1rem;text-shadow:0 0 12px rgba(120,170,255,.12)}a{color:#fff;text-decoration:none;transition:opacity .2s ease,color .2s ease}a:hover{opacity:.82;color:#d8e7ff}img{display:block;max-width:100%;height:auto}.site-header{position:sticky;top:0;z-index:9000;background:0 0}.site-header::before{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(180deg,rgba(0,0,0,.28) 0%,rgba(0,0,0,.16) 65%,transparent 100%);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);pointer-events:none}.site-header__inner{width:calc(100% - 4rem);max-width:1400px;margin:0 auto;padding:1.5rem 0;display:flex;align-items:center;justify-content:flex-start;gap:4rem;flex-wrap:nowrap;position:relative;z-index:1}.site-logo{flex-shrink:0;font-family:var(--font-title);font-size:2rem;color:#fff;line-height:.9;letter-spacing:.08em}.site-logo img{display:block;width:140px;height:auto}.site-nav{display:flex;align-items:center}.nav-root,.nav-dropdown{padding:0;margin:0;list-style:none}.nav-root{display:flex;align-items:center;gap:2rem}.nav-item{position:relative}.site-nav a{display:block;position:relative;padding:.35rem 0;font-size:.95rem;text-transform:uppercase;letter-spacing:.08em;color:rgba(255,255,255,.85);white-space:nowrap}.site-nav a::after{content:"";position:absolute;left:0;bottom:-.25rem;width:0;height:1px;background:#fff;transition:width .25s ease}.site-nav a:hover::after,.site-nav a.is-active::after{width:100%}.nav-dropdown{position:absolute;top:100%;left:0;z-index:5000;min-width:220px;padding:.75rem 0;background:rgba(2,11,31,.96);border:1px solid rgba(255,255,255,.12);opacity:0;visibility:hidden;transform:translateY(.5rem);transition:opacity .2s ease,transform .2s ease,visibility .2s ease}.nav-item:hover>.nav-dropdown,.nav-item:focus-within>.nav-dropdown{opacity:1;visibility:visible;transform:translateY(0)}.nav-dropdown a{padding:.5rem 1rem;font-size:.82rem}.nav-dropdown a::after{display:none}.nav-dropdown a:hover{background:rgba(255,255,255,8%)}.nav-subdropdown{top:-.75rem;left:100%;transform:translateX(.5rem)}.nav-item:hover>.nav-subdropdown,.nav-item:focus-within>.nav-subdropdown{transform:translateX(0)}.home-news{display:flex;justify-content:center;padding-top:4rem}.news-card{width:100%;max-width:820px;padding:3rem;background:rgba(0,0,0,.18);backdrop-filter:blur(6px);border:1px solid rgba(255,255,255,8%)}.news-card p{margin-bottom:1.5rem;font-size:1.05rem;line-height:1.8}.news-card a{color:#fff;text-decoration:underline}.news-card iframe{width:100%;aspect-ratio:16/9;margin-top:2rem;border:0}.festival-banner-link{display:block;width:90%;margin:2rem auto 2.5rem;overflow:hidden;border:0;text-decoration:none}.festival-banner-link img{display:block;width:100%;height:auto}.news-card iframe{display:block;width:100%;aspect-ratio:16/9;margin-top:2rem;margin-bottom:0;border:0}.news-card p:empty,.news-card p:has(br:only-child){display:none}.festival-article-link{display:flex;justify-content:space-between;align-items:center;gap:1rem;margin-top:2rem;padding:1rem 1.25rem;text-decoration:none;border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.035);transition:background .25s ease,border-color .25s ease,transform .25s ease}.festival-article-link:hover{background:rgba(255,255,255,7%);border-color:rgba(255,255,255,.28);transform:translateY(-2px)}.photo-grid,.gallery-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem;margin-top:var(--space-lg)}.photo-card{display:block;text-decoration:none;transition:transform .2s ease,opacity .2s ease}.photo-card:hover{transform:translateY(-4px)}.photo-card p{margin-top:.75rem;font-size:.95rem;letter-spacing:.04em;text-transform:uppercase;color:var(--color-text)}.photo-thumb{position:relative;width:100%;aspect-ratio:4/3;overflow:hidden;border:1px solid var(--color-border);background:rgba(255,255,255,3%)}.photo-thumb img{width:100%;height:100%;object-fit:cover;transition:transform .35s ease,opacity .35s ease}.photo-card:hover .photo-thumb img{transform:scale(1.03)}.photo-thumb::after{content:attr(data-title);position:absolute;inset:0;display:grid;place-items:center;padding:1rem;background:rgba(0,0,0,.45);color:#fff;font-size:1rem;letter-spacing:.08em;text-transform:uppercase;text-align:center;opacity:0;transition:opacity .25s ease}.photo-card:hover .photo-thumb::after{opacity:1}.gallery-item{display:block;width:100%;padding:0;overflow:hidden;border:1px solid var(--color-border);background:0 0;cursor:pointer}.gallery-item img{width:100%;aspect-ratio:4/3;object-fit:cover;transition:transform .35s ease,opacity .35s ease}.gallery-item:hover img{transform:scale(1.03)}.lightbox{position:fixed;inset:0;z-index:10000;display:grid;grid-template-columns:4rem minmax(0,1fr)4rem;place-items:center;gap:1rem;padding:2rem;background:rgba(0,0,0,.94)}.lightbox[hidden]{display:none}.lightbox-content{display:grid;gap:1rem;justify-items:center;max-width:95vw}.lightbox-image{max-width:85vw;max-height:75vh;object-fit:contain}.lightbox-close{position:fixed;top:1.5rem;right:1.5rem;z-index:10001;display:flex;align-items:center;justify-content:center;width:3.25rem;height:3.25rem;padding:0;font-family:Arial,sans-serif;font-size:2.4rem;line-height:1;color:#fff;background:rgba(0,0,0,.75);border:1px solid rgba(255,255,255,.75);border-radius:999px;cursor:pointer;transition:background .2s ease,transform .2s ease}.lightbox-close:hover{background:rgba(255,255,255,.15);transform:scale(1.05)}.lightbox-nav{z-index:10001;width:3rem;height:3rem;font-size:2rem;line-height:1;color:#fff;background:rgba(0,0,0,.4);border:1px solid rgba(255,255,255,.75);cursor:pointer;transition:background .2s ease,transform .2s ease}.lightbox-nav:hover{background:rgba(255,255,255,.15);transform:scale(1.05)}.lightbox-thumbs{display:flex;gap:.75rem;max-width:85vw;overflow-x:auto;padding:.5rem}.lightbox-thumb{flex:none;width:5rem;height:3.75rem;padding:0;border:2px solid transparent;background:0 0;cursor:pointer;opacity:.5;transition:opacity .2s ease,border-color .2s ease,transform .2s ease}.lightbox-thumb:hover{opacity:.8}.lightbox-thumb.is-active{border-color:#fff;opacity:1;transform:scale(1.05)}.lightbox-thumb img{width:100%;height:100%;object-fit:cover}@media(max-width:900px){.photo-grid,.gallery-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:640px){.photo-grid,.gallery-grid{grid-template-columns:1fr}.lightbox{grid-template-columns:1fr;padding:1rem}.lightbox-prev,.lightbox-next{position:fixed;top:50%;transform:translateY(-50%)}.lightbox-prev{left:1rem}.lightbox-next{right:1rem}.lightbox-image{max-width:92vw;max-height:70vh}}.film-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:var(--space-md);margin-top:var(--space-lg)}.film-card{display:block;text-decoration:none;transition:transform .2s ease}.film-card:hover{transform:translateY(-4px)}.film-poster{position:relative;aspect-ratio:3/4;border:1px solid var(--color-border);overflow:hidden;background:#ddd}.film-poster img{width:100%;height:100%;object-fit:cover}.film-poster::after{content:attr(data-title);position:absolute;inset:0;display:grid;place-items:center;background:rgba(0,0,0,.4);color:#fff;opacity:0;transition:opacity .2s ease}.film-card:hover .film-poster::after{opacity:1}.video-wrapper{margin-top:var(--space-lg);border:1px solid var(--color-border);background:#000;aspect-ratio:16/9}.video-wrapper iframe{width:100%;height:100%;border:0}.film-page{max-width:960px;margin:0 auto}.film-content{margin-top:var(--space-lg)}.film-gallery{margin-top:var(--space-lg)}.film-gallery h2{margin-bottom:var(--space-md)}.contact-layout{display:grid;grid-template-columns:240px 1px minmax(0,1fr);gap:3rem;align-items:start}.contact-side{min-height:500px}.contact-separator{width:1px;min-height:100%;background:rgba(255,255,255,.12)}.contact-content{max-width:680px}.contact-list{display:flex;flex-direction:column;gap:1rem;margin-top:2rem;padding:0;list-style:none}.social-link{display:inline-flex;align-items:center;gap:.85rem;font-size:1rem;letter-spacing:.04em}.social-icon{flex:0 0 24px;width:24px;height:24px;object-fit:contain;object-position:center;border-radius:4px}@media(max-width:900px){.contact-layout{grid-template-columns:1fr}.contact-separator,.contact-side{display:none}}